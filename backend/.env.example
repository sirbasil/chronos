# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env — it is listed in .gitignore.

# PostgreSQL credentials
POSTGRES_USER=chronos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chronos
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Orders service — URL used to reach the Payment service.
# Inside Docker Compose this should be http://payment:8001
# For local dev outside Docker set to http://127.0.0.1:8001
PAYMENT_SERVICE_URL=http://payment:8001

# Failure injection (disabled by default)
ENABLE_FAILURE_INJECTION=false
COMPOSE_PROJECT_NAME=01-http-basics

# Internal Failure Controller (Docker isolation)
# The failure-controller is an isolated internal service communicating over a private Docker network.
# FAILURE_CONTROLLER_URL inside Docker Compose: http://failure-controller:8002
# For local dev outside Docker: http://127.0.0.1:8002
FAILURE_CONTROLLER_URL=http://failure-controller:8002
# High-entropy shared secret for service-to-service authentication between Orders and failure-controller.
# Generate a secure secret using: openssl rand -hex 32  OR  python -c "import secrets; print(secrets.token_hex(32))"
FAILURE_CONTROLLER_TOKEN=placeholder_generate_with_openssl_rand_hex_32

# Host Docker daemon socket numeric Group ID.
# Required by failure-controller to communicate with /var/run/docker.sock without root privileges.
# Determine the host GID by running: stat -c '%g' /var/run/docker.sock
# Common values: 1001 (WSL/Ubuntu desktop), 999 (standard Docker CE / Debian / Ubuntu server), 994 (Amazon Linux 2023).
DOCKER_GID=1001

# CORS allowed origins (comma-separated).
# Defaults to local browser dev (Vite port 5173):
# http://localhost:5173,http://127.0.0.1:5173
# For AWS production deployment, specify your AWS Amplify frontend HTTPS origin:
# CORS_ALLOWED_ORIGINS=https://main.example.amplifyapp.com
# Note: Wildcard '*' is strictly prohibited and automatically rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Amazon Cognito User Pool Authentication & RBAC
# APP_ENV: "development" fails closed with 503 if unconfigured; "production" aborts startup if unconfigured.
APP_ENV=development
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_tDVeeHq0g
COGNITO_USER_POOL_CLIENT_ID=4268fo6vpodgv8dt37tim2aec3
COGNITO_ADMIN_GROUP=chronos-admins
COGNITO_OPERATOR_GROUP=chronos-operators
