FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Apply available Debian security updates and create dedicated non-root chronos user
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -g 1001 chronos && \
    useradd -u 1001 -g chronos -s /bin/sh -m chronos

WORKDIR /app

# Install dependencies first for layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the files this service needs
COPY event_schema.py .
COPY database.py .
COPY auth.py .
COPY failure_injector.py .
COPY server_fastapi.py .

USER chronos

EXPOSE 8000

CMD ["uvicorn", "server_fastapi:app", "--host", "0.0.0.0", "--port", "8000"]
