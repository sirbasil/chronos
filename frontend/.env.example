# Copy this file to .env.local for local overrides if needed.
# IMPORTANT: All VITE_* variables are public and embedded directly into the client JavaScript bundle.
# NEVER store secrets, private keys, passwords, or credentials in VITE_* variables.

# Backend API Base URL.
# In local development, defaults to: http://127.0.0.1:8000
# For AWS deployment, configure VITE_API_BASE_URL in the AWS Amplify Console:
# VITE_API_BASE_URL=https://api.chronos.example.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Amazon Cognito Authentication Configuration
# Public configuration for OAuth2 PKCE Authorization Code Grant with Cognito Managed Login.
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_tDVeeHq0g
VITE_COGNITO_USER_POOL_CLIENT_ID=4268fo6vpodgv8dt37tim2aec3
VITE_COGNITO_OAUTH_DOMAIN=chronos-auth-519725697841.auth.ap-south-1.amazoncognito.com
# Local development origin defaults to Vite port 5173 (Cognito allowed callback).
# Note: For production, set this to your Amplify domain (e.g. https://main.<app-id>.amplifyapp.com/)
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/
