# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env — it is listed in .gitignore.

# PostgreSQL credentials
POSTGRES_USER=chronos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chronos
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Orders service — URL used to reach the Payment service.
# Inside Docker Compose this should be http://payment:8001
# For local dev outside Docker set to http://127.0.0.1:8001
PAYMENT_SERVICE_URL=http://payment:8001

